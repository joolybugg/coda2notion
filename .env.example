# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real tokens.

# Coda API token (Coda/Superhuman Docs account settings -> API)
CODA_API_TOKEN=your-coda-api-token

# Notion internal integration secret (https://www.notion.so/my-integrations)
NOTION_API_TOKEN=ntn_your-notion-integration-secret

# Coda doc id: the part after "_d" in a doc URL
# e.g. https://docs.superhuman.com/d/MyDoc_dAbCdEf123  ->  AbCdEf123
CODA_DOC_ID=your-coda-doc-id

# Notion page the databases are created under.
# The integration must be connected to this page (page ... -> Connections).
NOTION_PARENT_PAGE_ID=your-notion-parent-page-id

# Optional: table filters (comma-separated table names).
# Skip specific tables (deny-list):
# CODA_SKIP_TABLES=Emojis Table, Colors
# Or migrate only specific tables (allow-list):
# CODA_ONLY_TABLES=Projects, Workspaces

